# ============================================================
# Universal Agent Recovery — environment configuration
# Copy to `.env` and fill in. NEVER commit real secrets.
# All values below are placeholders only.
# ============================================================

# --- Storage ---
# Absolute path to the SQLite database shared by MCP server and Watchdog.
RECOVERY_DB_PATH=./data/recovery.db

# --- Security ---
# Comma-separated list of directories where agents may run.
# Tasks with working directories outside this list are rejected.
# Use absolute paths. Example: /Users/you/projects,/tmp/sandbox
RECOVERY_ALLOWED_DIRS=

# Global recovery switch: "true" enables the watchdog, "false" disables all recovery.
RECOVERY_ENABLED=true

# --- Watchdog detection thresholds (milliseconds) ---
# A task is considered stale when no heartbeat/activity arrives within this window.
RECOVERY_STALE_MS=600000
# Max simultaneous recovery operations.
RECOVERY_MAX_CONCURRENT=2
# Max runtime for a single recovery launch, in milliseconds.
RECOVERY_MAX_RUNTIME_MS=3600000

# --- Retry policy ---
RECOVERY_MAX_ATTEMPTS=5
RECOVERY_BACKOFF_BASE_MS=30000
RECOVERY_BACKOFF_MAX_MS=1800000

# --- Process ownership lease ---
RECOVERY_OWNER_LEASE_MS=300000

# --- Logging ---
# Log level: debug | info | warn | error
RECOVERY_LOG_LEVEL=info
# Optional file for JSON logs (in addition to stdout).
RECOVERY_LOG_FILE=./logs/recovery.log

# --- Agent binaries (optional overrides; resolved from PATH by default) ---
OPENCODE_BIN=opencode
CLAUDE_CODE_BIN=claude

# --- Generic CLI adapter (disabled unless explicitly configured) ---
# Template with {prompt} and optionally {session} placeholders.
# Example (documented interface only): myagent run --resume {session} "{prompt}"
RECOVERY_GENERIC_CLI_RESUME=
RECOVERY_GENERIC_CLI_NEW=
